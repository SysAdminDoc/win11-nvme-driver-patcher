<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4 authoring for the NVMe Driver Patcher MSI. Produces a single-file, per-machine
  installer that drops the main GUI exe, the CLI exe, the Tray exe, and the shipped
  data files (compat.json, windows_build_rules.json, feature_ids.json) into
  C:\Program Files\NVMe Driver Patcher\. Registers the Event Log source,
  creates the SchedulerService boot-time verifier task, and authors an ADMX-aware policy
  store registration.

  Build: `wix build packaging\wix\NVMeDriverPatcher.wxs -ext WixToolset.Util.wixext`
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
    Name="NVMe Driver Patcher"
    Manufacturer="SysAdminDoc"
    Version="5.7.0.0"
    UpgradeCode="9C2E3F01-6B91-4C1A-8F4D-09F7D8B4A3C2"
    Scope="perMachine">

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of NVMe Driver Patcher is already installed."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main" Title="NVMe Driver Patcher" Level="1" Display="expand">
      <ComponentGroupRef Id="InstallFolderSecurity" />
      <ComponentGroupRef Id="MainFiles" />
      <ComponentGroupRef Id="Shortcuts" />
      <ComponentGroupRef Id="EventLogSource" />
      <ComponentGroupRef Id="SharedDataFolder" />
    </Feature>

    <Feature Id="TrayAgent" Title="Status Tray Agent" Level="1">
      <ComponentGroupRef Id="TrayFiles" />
    </Feature>

    <Feature Id="AdmxTemplates" Title="Group Policy Templates (ADMX + ADML)" Level="1">
      <ComponentGroupRef Id="AdmxFiles" />
    </Feature>

    <!--
      Opt-in (Level 2 = not installed by default). The UI has no feature tree: a fresh install
      takes `msiexec /i NVMeDriverPatcher.msi ADDLOCAL=ALL`, an existing one adds it with
      `ADDLOCAL=WatchdogService`. Registers the
      real-time event-log watchdog as a LocalService auto-start service and removes
      it cleanly on uninstall.
    -->
    <Feature Id="WatchdogService" Title="Real-time Watchdog Service" Level="2">
      <ComponentGroupRef Id="WatchdogFiles" />
    </Feature>

    <!--
      Program Files only. The DACL pinned on INSTALLFOLDER below protects the files, but not the
      path to them: a standard user who can rename a parent (C:\Tools, or a user-made D:\Apps) can
      move the real folder aside and build their own tree at the same path, and the next elevated
      GUI launch, repair-time SYSTEM custom action or watchdog service start runs their binaries.
      Program Files and C:\ can't be renamed by them. Only an administrator can run this per-machine
      install, so this guards against a risky choice rather than an attacker. There's no folder
      picker; INSTALLFOLDER on the command line may name a folder inside Program Files (never
      Program Files itself, which would get the protected DACL below), and "\." or "/" is refused
      so ".." can't climb back out. There's deliberately no "Installed OR": in maintenance mode
      `ADDLOCAL=WatchdogService INSTALLFOLDER=D:\Apps` would put the new component in a folder that
      never gets the pinned DACL (InstallFolderPermissions is already installed). INSTALLFOLDER is
      unset before CostFinalize unless the command line sets it, and the folder the UI resolves is
      the installed one under Program Files, so repair and uninstall still pass.
      Test-InstallFolderAcl.ps1 matches the message text.
    -->
    <Launch
      Condition='NOT INSTALLFOLDER OR (INSTALLFOLDER ~&lt;&lt; ProgramFiles64Folder AND NOT (INSTALLFOLDER ~= ProgramFiles64Folder) AND NOT (INSTALLFOLDER &gt;&lt; "\.") AND NOT (INSTALLFOLDER &gt;&lt; "/"))'
      Message="NVMe Driver Patcher installs only under Program Files. A folder elsewhere can usually be renamed by a standard user, who could then swap in their own copy of programs that run with administrator rights. Leave INSTALLFOLDER unset, or point it at a folder inside Program Files." />

    <UI>
      <ui:WixUI Id="WixUI_Minimal" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui" />
    </UI>
    <!-- Issue #12: WixUI_Minimal shows a license page. Point it at our real product license/info
         RTF (product purpose, risk, recovery, MIT license) instead of WiX's default sample text. -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <CustomAction Id="GrantWatchdogRuntimeAccess"
                  FileRef="WatchdogExeFile"
                  ExeCommand="/grant-runtime-access"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />

    <InstallExecuteSequence>
      <Custom Action="GrantWatchdogRuntimeAccess"
              Before="StartServices"
              Condition="&amp;WatchdogService=3" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NVMe Driver Patcher" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="PROGRAMDATAFOLDER" Name="NVMePatcher">
        <Directory Id="PRIVILEGEDSTATEFOLDER" Name="State" />
        <Directory Id="WATCHDOGSTATEFOLDER" Name="Watchdog" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="NVMe Driver Patcher" />
    </StandardDirectory>

    <!--
      Component groups reference the published output of `dotnet publish`. The build pipeline
      is expected to place the assets at $(var.PublishDir)\... before invoking `wix build`.
    -->
    <!--
      INSTALLFOLDER can be set on the command line (inside Program Files, see the Launch condition
      above), and a directory created under a folder another vendor left writable inherits that
      folder's DACL - which would leave every shipped binary writable by a standard user while the
      MSI registers the watchdog as an auto-start service and invokes it from a deferred SYSTEM
      custom action. That is a direct write-to-SYSTEM-execution path. Pin the same protected DACL
      PROGRAMDATAFOLDER already gets:
      SYSTEM and Administrators full, Users read+execute, no inheritance from the parent. The ACEs
      are OICI so the binaries MSI drops in here inherit them, and the owner is forced to
      Administrators - a standard user who pre-created the target directory would otherwise keep
      WRITE_DAC through ownership and could put the write right back.
    -->
    <ComponentGroup Id="InstallFolderSecurity" Directory="INSTALLFOLDER">
      <Component Id="InstallFolderPermissions" Guid="B4E1B8B0-1C67-4A2E-9C25-7A0C6F2D4E11">
        <CreateFolder>
          <PermissionEx Sddl="O:BAD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="MainFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="*">
        <File Source="$(var.PublishDir)\NVMeDriverPatcher.exe" KeyPath="yes" />
      </Component>
      <Component Id="CliExe" Guid="*">
        <File Source="$(var.PublishDir)\NVMeDriverPatcher.Cli.exe" KeyPath="yes" />
      </Component>
      <Component Id="CompatJson" Guid="*">
        <File Source="$(var.PublishDir)\compat.json" KeyPath="yes" />
      </Component>
      <Component Id="BuildRulesJson" Guid="*">
        <File Source="$(var.PublishDir)\windows_build_rules.json" KeyPath="yes" />
      </Component>
      <Component Id="FeatureIdsJson" Guid="*">
        <File Source="$(var.PublishDir)\feature_ids.json" KeyPath="yes" />
      </Component>
      <Component Id="IconFile" Guid="*">
        <File Source="$(var.PublishDir)\icon.ico" KeyPath="yes" />
      </Component>
      <!--
        The shipped PowerShell module resolves the CLI exe from this value rather than from
        the current directory or $PATH: both exes are requireAdministrator, so a planted
        NVMeDriverPatcher.Cli.exe found by a relative lookup would run elevated.
      -->
      <Component Id="InstallLocationReg" Guid="*">
        <RegistryValue Root="HKLM"
                       Key="Software\SysAdminDoc\NVMeDriverPatcher"
                       Name="InstallLocation"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="TrayFiles" Directory="INSTALLFOLDER">
      <Component Id="TrayExe" Guid="*">
        <File Source="$(var.PublishDir)\NVMeDriverPatcher.Tray.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="WatchdogFiles" Directory="INSTALLFOLDER">
      <Component Id="WatchdogExe" Guid="*">
        <File Id="WatchdogExeFile" Source="$(var.PublishDir)\NVMeDriverPatcher.Watchdog.exe" KeyPath="yes" />
        <!-- Same service name the exe's own /install path creates via sc.exe, so both
             install routes converge on one service identity. -->
        <ServiceInstall Id="WatchdogSvcInstall"
                        Name="NVMeDriverPatcherWatchdog"
                        DisplayName="NVMe Driver Patcher Watchdog"
                        Description="Subscribes to the System event log and feeds the NVMe Driver Patcher watchdog state in real time."
                        Start="auto"
                        Type="ownProcess"
                        Account="NT AUTHORITY\LocalService"
                        ErrorControl="normal">
          <ServiceConfig OnInstall="yes"
                         OnReinstall="yes"
                         ServiceSid="restricted"
                         FailureActionsWhen="failedToStopOrReturnedError">
            <RequiredPrivilege Name="SeChangeNotifyPrivilege" />
          </ServiceConfig>
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="none"
                              ResetPeriodInDays="1"
                              RestartServiceDelayInSeconds="10" />
        </ServiceInstall>
        <ServiceControl Id="WatchdogSvcControl"
                        Name="NVMeDriverPatcherWatchdog"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="MainShortcut"
                  Name="NVMe Driver Patcher"
                  Description="Enable the Server 2025 Native NVMe driver on Windows 11"
                  Target="[INSTALLFOLDER]NVMeDriverPatcher.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="MainIcon.ico" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\SysAdminDoc\NVMeDriverPatcher"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="EventLogSource" Directory="INSTALLFOLDER">
      <Component Id="EventLogSourceReg" Guid="*">
        <util:EventSource Log="Application"
                          Name="NVMe Driver Patcher"
                          EventMessageFile="[INSTALLFOLDER]NVMeDriverPatcher.exe" />
        <RegistryValue Root="HKLM"
                       Key="Software\SysAdminDoc\NVMeDriverPatcher"
                       Name="EventLogSourceRegistered"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="SharedDataFolder" Directory="PROGRAMDATAFOLDER">
      <Component Id="SharedDataDirectory" Guid="*">
        <CreateFolder>
          <!-- Owner=Administrators; protected DACL. Standard users and the restricted
               watchdog token can read shared config but cannot create/replace children. -->
          <PermissionEx Sddl="O:BAD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)(A;OICI;0x1200a9;;;LS)(A;OICI;0x1200a9;;;S-1-5-80-153395662-1388266646-3167021078-3452987457-2818666036)" />
        </CreateFolder>
        <RegistryValue Root="HKLM"
                       Key="Software\SysAdminDoc\NVMeDriverPatcher"
                       Name="ProgramDataDirectoryCreated"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
      <Component Id="PrivilegedStateDirectory" Directory="PRIVILEGEDSTATEFOLDER" Guid="657EB463-8C4D-4E16-A525-EAB5DBF4284B">
        <CreateFolder>
          <PermissionEx Sddl="O:BAD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
        </CreateFolder>
      </Component>
      <Component Id="WatchdogStateDirectory" Directory="WATCHDOGSTATEFOLDER" Guid="5D3FB12D-C5AA-43F6-A732-44CF29E394FF">
        <CreateFolder>
          <PermissionEx Sddl="O:BAD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;LS)(A;OICI;0x1301bf;;;S-1-5-80-153395662-1388266646-3167021078-3452987457-2818666036)" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="AdmxFiles" Directory="INSTALLFOLDER">
      <Component Id="AdmxTemplate" Guid="*">
        <File Id="AdmxFile"
              Source="$(var.ProjectRoot)\packaging\admx\NVMeDriverPatcher.admx"
              KeyPath="yes" />
      </Component>
      <Component Id="AdmlTemplate" Guid="*">
        <File Id="AdmlFile"
              Source="$(var.ProjectRoot)\packaging\admx\en-US\NVMeDriverPatcher.adml"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Icon Id="MainIcon.ico" SourceFile="$(var.PublishDir)\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="MainIcon.ico" />
  </Package>
</Wix>
