<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NVMeDriverPatcher.Core</AssemblyName>
    <RootNamespace>NVMeDriverPatcher</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="compat.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="windows_build_rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="feature_ids.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="vivetool_trusted_releases.json" LogicalName="NVMeDriverPatcher.vivetool_trusted_releases.json" />
    <!-- Ship the ADMX/ADML templates beside every executable that references Core so
         `policy-install` works from GUI, CLI, and portable publish folders. -->
    <None Include="..\..\packaging\admx\NVMeDriverPatcher.admx" Link="admx\NVMeDriverPatcher.admx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\packaging\admx\en-US\NVMeDriverPatcher.adml" Link="admx\en-US\NVMeDriverPatcher.adml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- EF's transitive SQLitePCLRaw 2.1.11 bundle resolves an older native SQLite, so the
         direct bundle + SourceGear pins keep the native asset on the maintained 3.53.3 floor.
         The bundled native library compiles FTS5; defensive mode is enabled on every DB
         connection and SqliteVersionTests proves shadow-table writes are blocked. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
    <!-- bundle_e_sqlite3 3.0.4 resolves SourceGear.sqlite3 3.53.3. Keep the provider pinned
         DIRECTLY so every published RID (win-x64, win-arm64) ships the intended native library.
         Do not move this bundle to 3.0.5 without revalidating the native package identity:
         that release changes the transitive native package id and can orphan this pin.
         SqliteVersionTests pins both the runtime floor and the resolved native asset path. -->
    <PackageReference Include="SourceGear.sqlite3" Version="3.53.3" />
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
  </ItemGroup>

</Project>
