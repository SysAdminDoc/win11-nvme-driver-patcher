                                                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding RestartStageDetailText}"
                                                                       Margin="0,3,0,0"
                                                                       FontSize="{StaticResource FontSizeMeta}"
                                                                       Foreground="{DynamicResource TextMuted}"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="12,0,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="3"
                                                                Height="36"
                                                                Background="{Binding ValidationStageColor, Converter={StaticResource StrToBrush}}"
                                                                CornerRadius="0"
                                                                Opacity="0.76"
                                                                VerticalAlignment="Top"/>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <TextBlock Text="Validate" Style="{StaticResource SectionEyebrow}"/>
                                                            <TextBlock Text="{Binding ValidationStageStateText}"
                                                                       Margin="0,4,0,0"
                                                                       Foreground="{Binding ValidationStageColor, Converter={StaticResource StrToBrush}}"
                                                                       FontSize="{StaticResource FontSizeBodyLarge}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding ValidationStageDetailText}"
                                                                       Margin="0,3,0,0"
                                                                       FontSize="{StaticResource FontSizeMeta}"
                                                                       Foreground="{DynamicResource TextMuted}"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </UniformGrid>
                                            </Border>

                                            <Border Grid.Row="2"
                                                    Margin="0,10,0,0"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource InsetCard}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.05*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="Recovery Kit" Style="{StaticResource SectionEyebrow}"/>
                                                        <TextBlock Text="{Binding RecoveryKitStatusText}"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Margin="14,0,10,0"
                                                            VerticalAlignment="Top">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource StatusChipBorder}">
                                                                <Setter Property="Background" Value="{DynamicResource YellowBg}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Yellow}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasRecoveryKit}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource GreenBg}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Green}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusChipText}">
                                                                    <Setter Property="Text" Value="Missing"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource Yellow}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasRecoveryKit}" Value="True">
                                                                            <Setter Property="Text" Value="Ready"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource Green}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Button Content="Open"
                                                                Margin="0,0,8,0"
                                                                Style="{StaticResource SecondaryButton}"
                                                                ToolTip="Open the most recent recovery kit folder. Available after a kit has been generated or detected."
                                                                AutomationProperties.Name="Open recovery kit folder"
                                                                IsEnabled="{Binding HasRecoveryKit}"
                                                                Command="{Binding OpenLatestRecoveryKitCommand}"/>
                                                        <Button Content="Create"
                                                                Style="{StaticResource SecondaryButton}"
                                                                ToolTip="Export a fresh recovery kit so rollback stays available even if this install becomes unbootable."
                                                                AutomationProperties.Name="Create recovery kit copy"
                                                                IsEnabled="{Binding ButtonsEnabled}"
                                                                Command="{Binding ExportRecoveryKitCommand}"/>
                                                    </StackPanel>

                                                    <Border Grid.Row="1"
                                                            Grid.ColumnSpan="3"
                                                            Margin="0,8"
                                                            Height="1"
                                                            Background="{DynamicResource Border}"/>

                                                    <StackPanel Grid.Row="2">
                                                        <TextBlock Text="Verification Script" Style="{StaticResource SectionEyebrow}"/>
                                                        <TextBlock Text="{Binding VerificationScriptStatusText}"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Border Grid.Row="2"
                                                            Grid.Column="1"
                                                            Margin="14,0,10,0"
                                                            VerticalAlignment="Top">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource StatusChipBorder}">
                                                                <Setter Property="Background" Value="{DynamicResource YellowBg}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Yellow}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasVerificationScript}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource GreenBg}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Green}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusChipText}">
                                                                    <Setter Property="Text" Value="Missing"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource Yellow}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasVerificationScript}" Value="True">
                                                                            <Setter Property="Text" Value="Ready"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource Green}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Button Content="Review"
                                                                Margin="0,0,8,0"
                                                                Style="{StaticResource SecondaryButton}"
                                                                ToolTip="Open the latest verification script. Available after a script has been generated or detected."
                                                                AutomationProperties.Name="Review verification script"
                                                                IsEnabled="{Binding HasVerificationScript}"
                                                                Command="{Binding OpenVerificationScriptCommand}"/>
                                                        <Button Content="Generate"
                                                                Style="{StaticResource SecondaryButton}"
                                                                ToolTip="Create a post-reboot PowerShell checklist for the patch and Safe Mode keys."
                                                                AutomationProperties.Name="Generate verification script"
                                                                IsEnabled="{Binding ButtonsEnabled}"
                                                                Command="{Binding GenerateVerificationScriptCommand}"/>
                                                    </StackPanel>

                                                    <Border Grid.Row="3"
                                                            Grid.ColumnSpan="3"
                                                            Margin="0,8"
                                                            Height="1"
                                                            Background="{DynamicResource Border}"/>

                                                    <StackPanel Grid.Row="4">
                                                        <TextBlock Text="Diagnostics Report" Style="{StaticResource SectionEyebrow}"/>
                                                        <TextBlock Text="{Binding DiagnosticsReportStatusText}"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <Border Grid.Row="4"
                                                            Grid.Column="1"
                                                            Margin="14,0,10,0"
                                                            VerticalAlignment="Top">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource StatusChipBorder}">
                                                                <Setter Property="Background" Value="{DynamicResource YellowBg}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Yellow}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasDiagnosticsReport}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource GreenBg}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Green}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusChipText}">
                                                                    <Setter Property="Text" Value="Missing"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource Yellow}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasDiagnosticsReport}" Value="True">
                                                                            <Setter Property="Text" Value="Ready"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource Green}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Button Content="Review"
                                                                Margin="0,0,8,0"
                                                                Style="{StaticResource SecondaryButton}"
                                                                ToolTip="Open the latest diagnostics report. Available after a report has been generated or detected."
                                                                AutomationProperties.Name="Review diagnostics report"
                                                                IsEnabled="{Binding HasDiagnosticsReport}"
                                                                Command="{Binding OpenLatestDiagnosticsReportCommand}"/>
                                                        <Button Content="Export"
                                                                Margin="0,0,8,0"
                                                                Style="{StaticResource SecondaryButton}"
                                                                ToolTip="Export a fresh diagnostics report with health data, configuration, and recent activity."
                                                                AutomationProperties.Name="Export diagnostics report"
                                                                IsEnabled="{Binding ButtonsEnabled}"
                                                                Command="{Binding ExportDiagnosticsCommand}"/>
                                                        <Button Content="Bundle ZIP"
                                                                Style="{StaticResource SecondaryButton}"
                                                                ToolTip="Bundle the diagnostics report, config, crash logs, recent registry backups, and SQLite database into a single shareable ZIP."
                                                                AutomationProperties.Name="Export support bundle zip"
                                                                IsEnabled="{Binding ButtonsEnabled}"
                                                                Command="{Binding ExportSupportBundleCommand}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="3"
                                                    Margin="0,10,0,0"
                                                    Padding="12,10"
                                                    Background="{DynamicResource YellowBg}"
                                                    BorderBrush="{DynamicResource Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel>
                                                    <TextBlock Text="Keep one off-device copy"
                                                               Foreground="{DynamicResource Yellow}"
                                                               FontSize="{StaticResource FontSizeMeta}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="Before a restart or handoff, place the recovery kit somewhere outside this machine."
                                                               Margin="0,6,0,0"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               FontSize="{StaticResource FontSizeBody}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Style="{StaticResource WorkspaceTabItem}">
                                        <TabItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Tuning"/>
                                            </StackPanel>
                                        </TabItem.Header>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <views:TuningPanel x:Name="TuningPanelControl"
                                                               Grid.Row="1"
                                                               Margin="0"/>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Style="{StaticResource WorkspaceTabItem}">
                                        <TabItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Diagnostics"/>
                                            </StackPanel>
                                        </TabItem.Header>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Style="{StaticResource InsetCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="Read-only diagnostics" Style="{StaticResource SectionEyebrow}"/>
                                                        <TextBlock Text="Run a check to fill in its row below."
                                                                   Margin="0,4,0,0"
                                                                   Style="{StaticResource BodyCopy}"/>
                                                    </StackPanel>

                                                    <WrapPanel Grid.Column="1"
                                                               Margin="16,0,0,0"
                                                               VerticalAlignment="Center">
                                                        <Button Content="Watchdog"
                                                                Command="{Binding RefreshWatchdogStatusCommand}"
                                                                Style="{StaticResource SecondaryButton}"
                                                                AutomationProperties.Name="Refresh watchdog status"
                                                                ToolTip="Check the event log for storage errors since the patch, and whether the watchdog task is running."
                                                                Margin="0,0,8,0"/>
                                                        <Button Content="Reliability"
                                                                Command="{Binding RefreshReliabilityCommand}"
                                                                Style="{StaticResource SecondaryButton}"
                                                                AutomationProperties.Name="Refresh reliability correlation"
                                                                ToolTip="Compare Reliability Monitor records from before and after the patch."
                                                                Margin="0,0,8,0"/>
                                                        <Button Content="Minidumps"
                                                                Command="{Binding TriageMinidumpsCommand}"
                                                                Style="{StaticResource SecondaryButton}"
                                                                AutomationProperties.Name="Triage minidumps"
                                                                ToolTip="Scan crash dumps written since the patch for storage driver faults."
                                                                Margin="0,0,8,0"/>
                                                        <Button Content="Dry Run"
                                                                Command="{Binding PreviewDryRunCommand}"
                                                                Style="{StaticResource SecondaryButton}"
                                                                AutomationProperties.Name="Preview dry-run plan"
                                                                ToolTip="List every registry value Apply would write. Nothing is changed."/>
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="1"
                                                    Style="{StaticResource InsetCard}"
                                                    Margin="0,8,0,0"
                                                    VerticalAlignment="Top">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="118"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Watchdog" Style="{StaticResource SectionEyebrow}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding WatchdogVerdictText}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               FontSize="{StaticResource FontSizeBody}"/>

                                                    <Border Grid.Row="1"
                                                            Grid.ColumnSpan="2"
                                                            Margin="0,8"
                                                            Height="1"
                                                            Background="{DynamicResource Border}"/>
                                                    <TextBlock Grid.Row="2"
                                                               Text="Reliability"
                                                               Style="{StaticResource SectionEyebrow}"/>
                                                    <TextBlock Grid.Row="2"
                                                               Grid.Column="1"
                                                               Text="{Binding ReliabilitySummaryText}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               FontSize="{StaticResource FontSizeBody}"/>

                                                    <Border Grid.Row="3"
                                                            Grid.ColumnSpan="2"
                                                            Margin="0,8"
                                                            Height="1"
                                                            Background="{DynamicResource Border}"/>
                                                    <TextBlock Grid.Row="4"
                                                               Text="Minidumps"
                                                               Style="{StaticResource SectionEyebrow}"/>
                                                    <TextBlock Grid.Row="4"
                                                               Grid.Column="1"
                                                               Text="{Binding MinidumpSummaryText}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               FontSize="{StaticResource FontSizeBody}"/>

                                                    <Border Grid.Row="5"
                                                            Grid.ColumnSpan="2"
                                                            Margin="0,8"
                                                            Height="1"
                                                            Background="{DynamicResource Border}"/>
                                                    <TextBlock Grid.Row="6"
                                                               Margin="0,8,0,0"
                                                               Text="Dry run"
                                                               Style="{StaticResource SectionEyebrow}"/>
                                                    <Expander Grid.Row="6"
                                                              Grid.Column="1"
                                                              IsExpanded="True"
                                                              Style="{StaticResource DarkExpander}">
                                                        <Expander.Header>
                                                            <TextBlock Text="Planned registry writes"
                                                                       FontWeight="SemiBold"/>
                                                        </Expander.Header>
                                                        <TextBox Text="{Binding DryRunPreviewText, Mode=OneWay}"
                                                                 IsReadOnly="True"
                                                                 TextWrapping="Wrap"
                                                                 AcceptsReturn="True"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 AutomationProperties.Name="Dry-run preview output"
                                                                 FontFamily="Cascadia Code, Consolas, monospace"
                                                                 FontSize="{StaticResource FontSizeMeta}"
                                                                 MinHeight="120"
                                                                 MaxHeight="240"/>
                                                    </Expander>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Style="{StaticResource WorkspaceTabItem}">
                                        <TabItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Settings"/>
                                            </StackPanel>
                                        </TabItem.Header>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>

                                            <Border x:Name="SettingsProfileCard"
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Style="{StaticResource InsetCard}"
                                                    VerticalAlignment="Top">
                                                <StackPanel>
                                                    <TextBlock Text="Patch profile" Style="{StaticResource SectionEyebrow}"/>
                                                    <TextBlock Text="Choose what Apply writes. Safe suits most machines."
                                                               Margin="0,4,0,0"
                                                               Style="{StaticResource BodyCopy}"/>

                                                    <TextBlock Text="Install mode"
                                                               Margin="0,9,0,2"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               FontSize="{StaticResource FontSizeBody}"
                                                               FontWeight="SemiBold"/>
                                                    <RadioButton Content="Safe profile (recommended)"
                                                                 Style="{StaticResource DarkRadioButton}"
                                                                 GroupName="VisiblePatchProfile"
                                                                 ToolTip="{Binding SafeProfileToolTip}"
                                                                 IsChecked="{Binding IsSafeModeSelected}"
                                                                 IsEnabled="{Binding PatchProfileEditable}"
                                                                 ToolTipService.ShowOnDisabled="True"/>
                                                    <RadioButton Content="Full profile"
                                                                 Style="{StaticResource DarkRadioButton}"
                                                                 GroupName="VisiblePatchProfile"
                                                                 ToolTip="{Binding FullProfileToolTip}"
                                                                 IsChecked="{Binding IsFullModeSelected}"
                                                                 IsEnabled="{Binding PatchProfileEditable}"
                                                                 ToolTipService.ShowOnDisabled="True"/>
                                                    <CheckBox Content="Also write 156965516"
                                                              Margin="26,2,0,0"
                                                              Style="{StaticResource DarkCheckBox}"
                                                              AutomationProperties.Name="Also write feature flag 156965516 with the Full profile"
                                                              ToolTip="{Binding StandaloneFutureToolTip}"
                                                              IsEnabled="{Binding StandaloneFutureEditable}"
                                                              IsChecked="{Binding IncludeStandaloneFuture}"
                                                              ToolTipService.ShowOnDisabled="True"/>
                                                    <TextBlock Text="{Binding PatchProfileHelpText}"
                                                               Margin="0,6,0,0"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               FontSize="{StaticResource FontSizeMeta}"
                                                               TextWrapping="Wrap"/>
                                                    <CheckBox Content="Also write the Server 2025 key"
                                                              Margin="0,8,0,0"
                                                              Style="{StaticResource DarkCheckBox}"
                                                              ToolTip="{Binding ServerKeyToolTip}"
                                                              IsChecked="{Binding IncludeServerKey}"
                                                              IsEnabled="{Binding ServerKeyEditable}"
                                                              ToolTipService.ShowOnDisabled="True"/>

                                                    <Border Margin="0,8,0,0"
                                                            Padding="10,8"
                                                            Background="{DynamicResource YellowBg}"
                                                            BorderBrush="{DynamicResource Border}"
                                                            BorderThickness="1"
                                                            CornerRadius="8">
                                                        <TextBlock Text="DirectStorage and BypassIO may fall back on nvmedisk.sys. Keep removal available on gaming systems."
                                                                   Foreground="{DynamicResource Yellow}"
                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                   TextWrapping="Wrap"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <Border x:Name="SettingsAuditCard"
                                                    Grid.Row="0"
                                                    Grid.Column="2"
                                                    Style="{StaticResource InsetCard}"
                                                    VerticalAlignment="Top">
                                                <StackPanel>
                                                    <TextBlock Text="Audit and alerts" Style="{StaticResource SectionEyebrow}"/>
                                                    <TextBlock Text="Changes here save as you make them."
                                                               Margin="0,4,0,0"
                                                               Style="{StaticResource BodyCopy}"/>

                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Theme"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   FontWeight="SemiBold"/>
                                                        <ComboBox x:Name="ThemeModeSelector"
                                                                  Grid.Column="2"
                                                                  MinWidth="180"
                                                                  HorizontalAlignment="Left"
                                                                  Style="{StaticResource DarkComboBox}"
                                                                  AutomationProperties.Name="Theme mode"
                                                                  ToolTip="Choose whether the app follows Windows, uses a fixed light or dark theme, or switches to the accessible contrast palette."
                                                                  SelectionChanged="ThemeModeSelector_SelectionChanged">
                                                            <ComboBoxItem Content="System" Tag="System" Style="{StaticResource DarkComboBoxItem}"/>
                                                            <ComboBoxItem Content="Light" Tag="Light" Style="{StaticResource DarkComboBoxItem}"/>
                                                            <ComboBoxItem Content="Dark" Tag="Dark" Style="{StaticResource DarkComboBoxItem}"/>
                                                            <ComboBoxItem Content="High Contrast" Tag="HighContrast" Style="{StaticResource DarkComboBoxItem}"/>
                                                        </ComboBox>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ThemeModeSummaryText}"
                                                               Margin="0,6,0,0"
                                                               Foreground="{DynamicResource TextDim}"
                                                               FontSize="{StaticResource FontSizeMeta}"
                                                               TextWrapping="Wrap"/>

                                                    <!-- One column: two half-width columns clipped these labels below about 1300 px. -->
                                                    <StackPanel x:Name="SettingsAuditToggles" Margin="0,8,0,0">
                                                        <CheckBox Content="Auto-save activity log"
                                                                  Style="{StaticResource DarkCheckBox}"
                                                                  ToolTip="Save this session&apos;s log to the data folder when the app closes."
                                                                  IsChecked="{Binding AutoSaveLog}"/>
                                                        <CheckBox Content="Toast notifications"
                                                                  Style="{StaticResource DarkCheckBox}"
                                                                  ToolTip="Show a Windows notification when an action finishes or needs attention."
                                                                  IsChecked="{Binding EnableToasts}"/>
                                                        <CheckBox Content="Windows Event Log"
                                                                  Style="{StaticResource DarkCheckBox}"
                                                                  ToolTip="Also record patch actions in the Windows Application event log."
                                                                  IsChecked="{Binding WriteEventLog}"/>
                                                    </StackPanel>

                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="84"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Restart delay"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBox Grid.Column="1"
                                                                 Margin="10,0"
                                                                 Style="{StaticResource DarkTextBox}"
                                                                 AutomationProperties.Name="Restart delay in seconds"
                                                                 ToolTip="Use a value between 5 and 300 seconds for post-patch restart countdowns."
                                                                 Text="{Binding RestartDelayText, UpdateSourceTrigger=LostFocus}"
                                                                 VerticalContentAlignment="Center"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="seconds (5 to 300)"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextDim}"/>
                                                    </Grid>

                                                    <WrapPanel Margin="0,10,0,0">
                                                        <Button Content="Open Data"
                                                                Margin="0,0,8,0"
                                                                Style="{StaticResource SecondaryButton}"
                                                                AutomationProperties.Name="Open data folder"
                                                                ToolTip="Open the working folder that stores logs, exports, backups, and diagnostics."
                                                                Command="{Binding OpenDataFolderCommand}"/>
                                                        <Button Content="Restore Defaults"
                                                                Style="{StaticResource SecondaryButton}"
                                                                AutomationProperties.Name="Restore recommended defaults"
                                                                ToolTip="Restore the app's recommended safety-first settings."
                                                                Command="{Binding UseRecommendedSetupCommand}"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>

                                            <Border x:Name="SettingsAboutCard"
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="3"
                                                    Margin="0,10,0,0"
                                                    Style="{StaticResource InsetCard}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="About" Style="{StaticResource SectionEyebrow}"/>
                                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyCopy}">
                                                            <Run Text="NVMe Driver Patcher"/>
                                                            <Run Text="{Binding VersionText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <WrapPanel Grid.Column="1"
                                                               Margin="12,0,0,0"
                                                               VerticalAlignment="Center">
                                                        <Button Content="GitHub"
                                                                Margin="0,0,8,0"
                                                                Style="{StaticResource SecondaryButton}"
                                                                AutomationProperties.Name="Open the project on GitHub"
                                                                ToolTip="Open the project page for releases, issues, and source code."
                                                                Command="{Binding OpenGitHubCommand}"/>
                                                        <Button Content="Microsoft docs"
                                                                Style="{StaticResource SecondaryButton}"
                                                                AutomationProperties.Name="Open Microsoft&apos;s native NVMe announcement"
                                                                ToolTip="Open Microsoft&apos;s announcement of the native NVMe driver."
                                                                Command="{Binding OpenDocsCommand}"/>
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </TabItem>
                                </TabControl>

                                <Border x:Name="ActivityRail"
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Grid.RowSpan="2"
                                        AutomationProperties.Name="Session activity monitor">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Padding" Value="14"/>
                                            <Setter Property="Background" Value="{DynamicResource SurfaceInset}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="CornerRadius" Value="10"/>
                                            <Setter Property="VerticalAlignment" Value="Top"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=ActivityLogToggle}" Value="True">
                                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock x:Name="ActivityRailEyebrow"
                                                           Text="SESSION MONITOR"
                                                           Style="{StaticResource SectionEyebrow}"/>
                                                <TextBlock Text="Activity"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           FontSize="{StaticResource FontSizeTitle}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock x:Name="LogRetentionCaption"
                                                           Text="{Binding LogRetentionText}"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextDim}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           LineHeight="14"
                                                           MaxHeight="16"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Margin="12,0,0,0"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Top">
                                                <Border Style="{StaticResource StatusChipBorder}"
                                                        BorderBrush="{Binding ActivityTabBadgeColor, Converter={StaticResource StrToBrush}}">
                                                    <TextBlock Text="{Binding ActivityTabBadgeText}"
                                                               Style="{StaticResource StatusChipText}"
                                                               Foreground="{Binding ActivityTabBadgeColor, Converter={StaticResource StrToBrush}}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel x:Name="ActivityRailSummary"
                                                    Grid.Row="1"
                                                    Margin="0,12,0,0">
                                            <Border Padding="12"
                                                    Background="{DynamicResource BgMedium}"
                                                    BorderBrush="{Binding ActivityTabBadgeColor, Converter={StaticResource StrToBrush}}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    AutomationProperties.Name="Session activity summary">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{Binding ActivityTabBadgeColor, Converter={StaticResource StrToBrush}}"
                                                            CornerRadius="0"/>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="SESSION SIGNAL"
                                                                   Style="{StaticResource SectionEyebrow}"/>
                                                        <TextBlock Text="{Binding ActivitySummaryText}"
                                                                   Margin="0,5,0,0"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                   LineHeight="17"
                                                                   TextWrapping="Wrap"/>
                                                        <WrapPanel Margin="0,10,0,0">
                                                            <TextBlock Text="{Binding LogEntryCountText}"
                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                       FontSize="{StaticResource FontSizeMeta}"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding LogWarningCountText}"
                                                                       Margin="12,0,0,0"
                                                                       Foreground="{DynamicResource Yellow}"
                                                                       FontSize="{StaticResource FontSizeMeta}"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding LogErrorCountText}"
                                                                       Margin="12,0,0,0"
                                                                       Foreground="{DynamicResource Red}"
                                                                       FontSize="{StaticResource FontSizeMeta}"
                                                                       FontWeight="SemiBold"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Margin="0,8,0,0"
                                                    Padding="12,10"
                                                    Background="{DynamicResource SurfaceCardBrush}"
                                                    BorderBrush="{DynamicResource Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    AutomationProperties.Name="Latest session event">
                                                <StackPanel>
                                                    <TextBlock Text="LATEST EVENT"
                                                               Style="{StaticResource SectionEyebrow}"/>
                                                    <TextBlock Text="{Binding LatestActivityText}"
                                                               Margin="0,5,0,0"
                                                               MaxHeight="38"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               FontSize="{StaticResource FontSizeMeta}"
                                                               LineHeight="17"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <ToggleButton x:Name="ActivityLogToggle"
                                                      Grid.Row="2"
                                                      Margin="0,10,0,0"
                                                      Style="{StaticResource ActivityDisclosureToggle}"
                                                      AutomationProperties.Name="Show or hide technical activity log"
                                                      IsChecked="False"
                                                      Checked="ActivityLogToggle_StateChanged"
                                                      Unchecked="ActivityLogToggle_StateChanged">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Technical log"/>
                                                <TextBlock Margin="6,0,0,0"
                                                           Foreground="{DynamicResource TextDim}"
                                                           Text="{Binding LogEntryCountText, StringFormat='· {0}'}"/>
                                            </StackPanel>
                                        </ToggleButton>

                                        <Grid Grid.Row="3" Margin="0,8,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=ActivityLogToggle}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Content="Copy"
                                                        Grid.Column="0"
                                                        MinWidth="0"
                                                        AutomationProperties.Name="Copy activity log"
                                                        ToolTip="Copy the whole session log to the clipboard."
                                                        Command="{Binding CopyLogCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LogEntryCount}" Value="0">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="Export"
                                                        Grid.Column="2"
                                                        MinWidth="0"
                                                        AutomationProperties.Name="Export activity log"
                                                        ToolTip="Save the session log as a text file."
                                                        Command="{Binding ExportLogCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LogEntryCount}" Value="0">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="Clear"
                                                        Grid.Column="4"
                                                        MinWidth="0"
                                                        AutomationProperties.Name="Clear activity log"
                                                        ToolTip="Clear this session&apos;s log. Saved exports aren&apos;t touched."
                                                        Click="ClearLog_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource WarningSecondaryButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LogEntryCount}" Value="0">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>

                                            <Border Grid.Row="1"
                                                    Margin="0,8,0,0"
                                                    Padding="8"
                                                    Background="{DynamicResource BgDarkest}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Focus}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            <Grid>
                                                <ScrollViewer x:Name="ActivityRailLogScroller"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <TextBox x:Name="ActivityRailLogOutput"
                                                             Text="{Binding LogText, Mode=OneWay}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             CaretBrush="Transparent"
                                                             AutomationProperties.Name="Persistent activity log output"
                                                             FontFamily="Cascadia Code,Consolas,Courier New"
                                                             FontSize="{StaticResource FontSizeCaption}"
                                                             Foreground="{DynamicResource TextSecondary}"
                                                             IsReadOnly="True"
                                                             IsTabStop="True"
                                                             Padding="0"
                                                             SelectionBrush="{DynamicResource AccentBg}"
                                                             TextChanged="LogOutput_TextChanged"
                                                             TextWrapping="Wrap">
                                                        <TextBox.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Copy Selection" Click="CopySelection_Click"/>
                                                                <MenuItem Header="Select All" Click="SelectAll_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="Copy Entire Log" Command="{Binding CopyLogCommand}"/>
                                                                <MenuItem Header="Clear Log" Click="ClearLog_Click"/>
                                                            </ContextMenu>
                                                        </TextBox.ContextMenu>
                                                    </TextBox>
                                                </ScrollViewer>

                                                <Border IsHitTestVisible="False">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LogEntryCount}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                MaxWidth="260">
                                                        <TextBlock Text="No activity yet"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   FontSize="{StaticResource FontSizeBodyLarge}"
                                                                   FontWeight="SemiBold"
                                                                   TextAlignment="Center"/>
                                                        <TextBlock Text="Checks and driver actions will appear here as they run."
                                                                   Margin="0,6,0,0"
                                                                   Foreground="{DynamicResource TextDim}"
                                                                   FontSize="{StaticResource FontSizeMeta}"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Row="4"
                                                    Margin="0,6,0,0"
                                                    Visibility="{Binding ProgressVisible, Converter={StaticResource BoolVis}}">
                                            <ProgressBar Height="6"
                                                         Value="{Binding ProgressValue}"
                                                         Foreground="{DynamicResource Accent}"
                                                         Template="{StaticResource RoundProgress}"
                                                         AutomationProperties.Name="Current operation progress"
                                                         AutomationProperties.LiveSetting="Polite"/>
                                            <TextBlock Text="{Binding ProgressText}"
                                                       Margin="0,6,0,0"
                                                       Foreground="{DynamicResource TextDim}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       TextTrimming="CharacterEllipsis"
                                                       AutomationProperties.LiveSetting="Polite"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.ColumnSpan="2"
                        Panel.ZIndex="4"
                        Background="{DynamicResource OverlayScrimBrush}"
                        AutomationProperties.Name="Readiness refresh overlay"
                        AutomationProperties.LiveSetting="Polite"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
                    <Grid>
                                <Border MaxWidth="520"
                                Margin="24"
                                Padding="28,24"
                                Background="{DynamicResource BgDark}"
                                BorderBrush="{DynamicResource BorderLight}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Effect="{DynamicResource WindowShadow}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Checking readiness"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="{StaticResource FontSizeMetric}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Verifying Windows build, storage path, NVMe inventory, and rollback safety."
                                           Margin="0,10,0,0"
                                           Style="{StaticResource BodyCopy}"/>

                                <ProgressBar Margin="0,14,0,0"
                                             Height="6"
                                             Foreground="{DynamicResource Accent}"
                                             AutomationProperties.Name="Refreshing readiness progress"
                                             AutomationProperties.LiveSetting="Polite"
                                             Template="{StaticResource RoundProgressIndeterminate}"/>

                                <UniformGrid Margin="0,12,0,0" Columns="3">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                        <Border Width="3" Height="14" Margin="0,1,8,0" Background="{DynamicResource Accent}" CornerRadius="0"/>
                                        <TextBlock Text="Build and driver" Style="{StaticResource BodyCopy}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                        <Border Width="3" Height="14" Margin="0,1,8,0" Background="{DynamicResource Accent}" CornerRadius="0"/>
                                        <TextBlock Text="Drive inventory" Style="{StaticResource BodyCopy}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="3" Height="14" Margin="0,1,8,0" Background="{DynamicResource Accent}" CornerRadius="0"/>
                                        <TextBlock Text="Rollback safety" Style="{StaticResource BodyCopy}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="This can take a few seconds while Windows storage and WMI data settle."
                                           Margin="0,16,0,0"
                                           Foreground="{DynamicResource TextDim}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
