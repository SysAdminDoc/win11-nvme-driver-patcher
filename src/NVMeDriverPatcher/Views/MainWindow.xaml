<Window x:Class="NVMeDriverPatcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NVMeDriverPatcher.Views"
        Title="NVMe Driver Patcher"
        Height="980"
        Width="1360"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource WindowCanvasBrush}"
        WindowStartupLocation="CenterScreen"
        MinHeight="720"
        MinWidth="1024"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid x:Name="RootFrame" Margin="0">
        <Border x:Name="ShellBorder"
                Background="{DynamicResource WindowCanvasBrush}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0"
                CornerRadius="0"
                ClipToBounds="False">

            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="14,18,14,14"
                        Background="{DynamicResource SurfaceInset}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="4,0,4,26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38"
                                    Height="38"
                                    Background="{DynamicResource AccentBg}"
                                    BorderBrush="{DynamicResource Accent}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Border Width="22"
                                            Height="18"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource Accent}"
                                            BorderThickness="1.5"
                                            CornerRadius="4"/>
                                    <TextBlock Text="N"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               FontWeight="Bold"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,1,0,0" VerticalAlignment="Center">
                                <TextBlock Text="NVMe Control"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontSize="{StaticResource FontSizeBodyLarge}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="DRIVER CONSOLE"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextDim}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Margin="12,0,0,10"
                                   Text="WORKSPACE"
                                   Style="{StaticResource SectionEyebrow}"/>

                        <ListBox x:Name="PrimaryNavigation"
                                 Grid.Row="2"
                                 SelectedIndex="{Binding SelectedIndex, ElementName=WorkspaceTabs, Mode=TwoWay}"
                                 Style="{StaticResource NavigationListBox}"
                                 AutomationProperties.Name="Primary navigation">
                            <ListBoxItem Style="{StaticResource NavigationListItem}" AutomationProperties.Name="Overview">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" Style="{StaticResource NavigationGlyph}"/>
                                    <TextBlock Text="Overview" Style="{StaticResource NavigationLabel}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavigationListItem}" AutomationProperties.Name="Drives and telemetry">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDA2;" Style="{StaticResource NavigationGlyph}"/>
                                    <TextBlock Text="Drives" Style="{StaticResource NavigationLabel}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavigationListItem}" AutomationProperties.Name="Recovery">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource NavigationGlyph}"/>
                                    <TextBlock Text="Recovery" Style="{StaticResource NavigationLabel}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavigationListItem}" AutomationProperties.Name="Advanced tuning">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9E9;" Style="{StaticResource NavigationGlyph}"/>
                                    <TextBlock Text="Tuning" Style="{StaticResource NavigationLabel}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavigationListItem}" AutomationProperties.Name="Diagnostics">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource NavigationGlyph}"/>
                                    <TextBlock Text="Diagnostics" Style="{StaticResource NavigationLabel}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavigationListItem}" AutomationProperties.Name="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource NavigationGlyph}"/>
                                    <TextBlock Text="Settings" Style="{StaticResource NavigationLabel}"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <Border Grid.Row="3"
                                Margin="4,18,4,0"
                                Padding="10"
                                Background="{DynamicResource BgMedium}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28"
                                        Height="28"
                                        Background="{DynamicResource GreenBg}"
                                        CornerRadius="6">
                                    <TextBlock Text="&#xEA18;"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="{StaticResource FontSizeBodyLarge}"
                                               Foreground="{DynamicResource Green}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Administrator"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontSize="{StaticResource FontSizeMeta}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding VersionText}"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextDim}"
                                               FontSize="{StaticResource FontSizeCaption}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="ShellAccentBar"
                        Grid.Column="1"
                        Height="2"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentLineBrush}"
                        CornerRadius="0"
                        Panel.ZIndex="2"/>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="TitleBarRegion"
                            Grid.Row="0"
                            Padding="24,16,24,12"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock FontSize="{StaticResource FontSizeMetric}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="System overview"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="1"><Setter Property="Text" Value="Drives &amp; telemetry"/></DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="2"><Setter Property="Text" Value="Recovery"/></DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="3"><Setter Property="Text" Value="Advanced tuning"/></DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="4"><Setter Property="Text" Value="Diagnostics"/></DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="5"><Setter Property="Text" Value="Settings"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="{StaticResource FontSizeBody}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Where the driver stands now and what to do next."/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="1"><Setter Property="Text" Value="Inspect NVMe devices, active drivers, health, and DirectStorage readiness."/></DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="2"><Setter Property="Text" Value="Rollback files and post-reboot checks, ready before you restart."/></DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="3"><Setter Property="Text" Value="Optional StorNVMe queue and power settings. Change one at a time."/></DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="4"><Setter Property="Text" Value="Read-only checks. Nothing here changes the system."/></DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="5"><Setter Property="Text" Value="Patch profile, theme, logging and restart timing."/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Margin="0,0,8,0"
                                        Padding="9,6"
                                        Background="{DynamicResource GreenBg}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEA18;"
                                                   Margin="0,0,6,0"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="{StaticResource FontSizeMeta}"
                                                   Foreground="{DynamicResource Green}"/>
                                        <TextBlock Text="ADMINISTRATOR"
                                                   FontSize="{StaticResource FontSizeCaption}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Green}"/>
                                    </StackPanel>
                                </Border>

                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButton}"
                                        AutomationProperties.Name="Refresh readiness checks"
                                        ToolTip="Run readiness checks again and rescan hardware inventory (F5)."
                                        Command="{Binding RefreshCommand}"
                                        IsEnabled="{Binding ButtonsEnabled}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;"
                                                   Margin="0,0,6,0"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                        <TextBlock Text="Refresh"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource BadgeButton}"
                                        Margin="0,0,8,0"
                                        Background="{DynamicResource YellowBg}"
                                        Foreground="{DynamicResource Yellow}"
                                        AutomationProperties.Name="Open available update"
                                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolVis}}"
                                        Command="{Binding OpenUpdateUrlCommand}"
                                        ToolTip="{Binding UpdateTooltip}">
                                    <TextBlock Text="{Binding UpdateVersionText}" FontSize="{StaticResource FontSizeMeta}" FontWeight="SemiBold"/>
                                </Button>

                                <Button x:Name="ThemeToggleButton"
                                        Content="&#x2600;"
                                        Style="{StaticResource WindowChromeButton}"
                                        FontFamily="Segoe UI Symbol"
                                        FontSize="{StaticResource FontSizeBodyLarge}"
                                        AutomationProperties.Name="Toggle theme"
                                        Click="ThemeToggle_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>


                    <Border x:Name="CommandDeck"
                            Grid.Row="1"
                            Margin="20,16,20,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource HeroCard}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="2"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="3"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="4"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="5"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Canvas Grid.RowSpan="2"
                                    IsHitTestVisible="False"
                                    ClipToBounds="True"
                                    Opacity="0.16">
                                <Path Data="M 620,18 C 760,0 860,52 1010,28 S 1210,8 1320,52"
                                      Stroke="{DynamicResource AccentSoft}"
                                      StrokeThickness="1"
                                      Fill="Transparent"/>
                                <Path Data="M 590,42 C 740,18 850,76 1015,52 S 1215,28 1340,78"
                                      Stroke="{DynamicResource AccentSoft}"
                                      StrokeThickness="1"
                                      Fill="Transparent"/>
                                <Path Data="M 650,68 C 790,45 900,100 1060,78 S 1240,58 1360,104"
                                      Stroke="{DynamicResource BorderLight}"
                                      StrokeThickness="1"
                                      Fill="Transparent"/>
                                <Path Data="M 930,160 C 1020,120 1110,120 1180,166 S 1290,208 1380,170"
                                      Stroke="{DynamicResource BorderLight}"
                                      StrokeThickness="1"
                                      Fill="Transparent"/>
                            </Canvas>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="NATIVE NVME STATUS" Style="{StaticResource SectionEyebrow}"/>
                                        <Border Margin="10,-3,0,0"
                                                Padding="8,4"
                                                Background="{DynamicResource SurfaceInset}"
                                                BorderBrush="{Binding StatusColor, Converter={StaticResource StrToBrush}}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                AutomationProperties.Name="Current patch state">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="6"
                                                           Height="6"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center"
                                                           Fill="{Binding StatusColor, Converter={StaticResource StrToBrush}}"/>
                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="{Binding StatusColor, Converter={StaticResource StrToBrush}}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusText}"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontSize="{StaticResource FontSizeDisplay}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding StatusSummaryText}"
                                                Margin="0,7,0,0"
                                                MaxWidth="720"
                                                HorizontalAlignment="Left"
                                                Foreground="{DynamicResource TextMuted}"
                                               FontSize="{StaticResource FontSizeBodyLarge}"
                                                LineHeight="19"
                                                TextWrapping="Wrap"/>

                                    <Grid Margin="0,12,0,0"
                                          MaxWidth="720"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="Safety journey">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <Border Style="{StaticResource WorkflowNode}"
                                                    BorderBrush="{Binding ScanStageColor, Converter={StaticResource StrToBrush}}">
                                                <TextBlock Text="1"
                                                           Foreground="{Binding ScanStageColor, Converter={StaticResource StrToBrush}}"
                                                           Style="{StaticResource WorkflowNodeNumber}"/>
                                            </Border>
                                            <TextBlock Text="Scan" Style="{StaticResource WorkflowStepLabel}"/>
                                            <TextBlock Text="{Binding ScanStageStateText}"
                                                       ToolTip="{Binding ScanStageDetailText}"
                                                       Style="{StaticResource WorkflowStepDetail}"/>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Height="1"
                                                Margin="0,17,0,0"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource BorderLight}"/>

                                        <StackPanel Grid.Column="2">
                                            <Border Style="{StaticResource WorkflowNode}"
                                                    BorderBrush="{Binding PreparationStageColor, Converter={StaticResource StrToBrush}}">
                                                <TextBlock Text="2"
                                                           Foreground="{Binding PreparationStageColor, Converter={StaticResource StrToBrush}}"
                                                           Style="{StaticResource WorkflowNodeNumber}"/>
                                            </Border>
                                            <TextBlock Text="Protect" Style="{StaticResource WorkflowStepLabel}"/>
                                            <TextBlock Text="{Binding PreparationStageStateText}"
                                                       MaxHeight="30"
                                                       ToolTip="{Binding PreparationStageDetailText}"
                                                       Style="{StaticResource WorkflowStepDetail}"/>
                                        </StackPanel>

                                        <Border Grid.Column="3"
                                                Height="1"
                                                Margin="0,17,0,0"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource BorderLight}"/>

                                        <StackPanel Grid.Column="4">
                                            <Border Style="{StaticResource WorkflowNode}"
                                                    BorderBrush="{Binding RestartStageColor, Converter={StaticResource StrToBrush}}">
                                                <TextBlock Text="3"
                                                           Foreground="{Binding RestartStageColor, Converter={StaticResource StrToBrush}}"
                                                           Style="{StaticResource WorkflowNodeNumber}"/>
                                            </Border>
                                            <TextBlock Text="Apply" Style="{StaticResource WorkflowStepLabel}"/>
                                            <TextBlock Text="{Binding RestartStageStateText}"
                                                       MaxHeight="30"
                                                       ToolTip="{Binding RestartStageDetailText}"
                                                       Style="{StaticResource WorkflowStepDetail}"/>
                                        </StackPanel>

                                        <Border Grid.Column="5"
                                                Height="1"
                                                Margin="0,17,0,0"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource BorderLight}"/>

                                        <StackPanel Grid.Column="6">
                                            <Border Style="{StaticResource WorkflowNode}"
                                                    BorderBrush="{Binding ValidationStageColor, Converter={StaticResource StrToBrush}}">
                                                <TextBlock Text="4"
                                                           Foreground="{Binding ValidationStageColor, Converter={StaticResource StrToBrush}}"
                                                           Style="{StaticResource WorkflowNodeNumber}"/>
                                            </Border>
                                            <TextBlock Text="Verify" Style="{StaticResource WorkflowStepLabel}"/>
                                            <TextBlock Text="{Binding ValidationStageStateText}"
                                                       MaxHeight="30"
                                                       ToolTip="{Binding ValidationStageDetailText}"
                                                       Style="{StaticResource WorkflowStepDetail}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Margin="0,10,0,0"
                                            Padding="10,7"
                                            MaxWidth="720"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource SurfaceInset}"
                                            BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{Binding NextStepColor, Converter={StaticResource StrToBrush}}" CornerRadius="0"/>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding NextStepTitle}"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding NextStepDescription}"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource TextDim}"
                                                           FontSize="{StaticResource FontSizeMeta}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Mutation-blocked notice. Without it a build-policy
                                         refusal left a permanently disabled Apply button and
                                         no visible reason anywhere in the window. -->
                                    <Border Margin="0,10,0,0"
                                            Padding="13,11"
                                            MaxWidth="720"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource YellowBg}"
                                            BorderBrush="{DynamicResource Yellow}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            AutomationProperties.Name="Patch actions turned off"
                                            Visibility="{Binding BuildPolicyBlocked, Converter={StaticResource BoolVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MutationBlockedTitle}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding MutationBlockedReason}"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       FontSize="{StaticResource FontSizeMeta}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding MutationBlockedGuidance}"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextDim}"
                                                       FontSize="{StaticResource FontSizeMeta}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Button Content="{Binding ApplyButtonText}"
                                                MinWidth="142"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource ActionButton}"
                                                AutomationProperties.Name="Apply patch"
                                                IsEnabled="{Binding ApplyEnabled}"
                                                ToolTip="{Binding ApplyButtonTooltipText}"
                                                Command="{Binding ApplyPatchCommand}"/>
                                        <Button Content="Remove"
                                                MinWidth="88"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource DangerButton}"
                                                AutomationProperties.Name="Remove patch"
                                                IsEnabled="{Binding RemoveEnabled}"
                                                ToolTip="{Binding RemoveButtonTooltipText}"
                                                Command="{Binding RemovePatchCommand}"/>
                                        <Button Content="Create Recovery Kit"
                                                MinWidth="146"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource SecondaryButton}"
                                                AutomationProperties.Name="Create recovery kit"
                                                ToolTip="Export a recovery kit so rollback stays available even if Windows won&apos;t boot."
                                                Command="{Binding ExportRecoveryKitCommand}"
                                                IsEnabled="{Binding ButtonsEnabled}"/>
                                        <!-- Conditional affordances. Each was previously bound
                                             only inside a permanently collapsed grid, so the
                                             feature behind it was unreachable from the GUI. -->
                                        <Button Content="Cancel Benchmark"
                                                MinWidth="152"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource WarningSecondaryButton}"
                                                ToolTip="Stop the current DiskSpd run. Partial data is discarded."
                                                AutomationProperties.Name="Cancel running benchmark"
                                                Visibility="{Binding BenchmarkRunning, Converter={StaticResource BoolVis}}"
                                                Command="{Binding CancelBenchmarkCommand}"/>
                                        <Button Content="Try Fallback"
                                                MinWidth="120"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="Enable the native FeatureStore fallback, then ViVeTool only if that fails."
                                                AutomationProperties.Name="Try the native FeatureStore fallback"
                                                Visibility="{Binding ShowViVeToolFallbackBadge, Converter={StaticResource BoolVis}}"
                                                IsEnabled="{Binding ButtonsEnabled}"
                                                Command="{Binding ApplyViVeToolFallbackCommand}"/>
                                        <Button Content="Upgrade Safe Boot Entries"
                                                MinWidth="196"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="Add the KB5079391 service-name Safe Boot entries missing from pre-v4.6.1 patches."
                                                AutomationProperties.Name="Upgrade Safe Boot entries"
                                                Visibility="{Binding ShowSafeBootUpgradeBadge, Converter={StaticResource BoolVis}}"
                                                IsEnabled="{Binding ButtonsEnabled}"
                                                Command="{Binding UpgradeSafeBootEntriesCommand}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Margin="22,0,0,0"
                                        Padding="17,16"
                                        VerticalAlignment="Stretch"
                                        Background="{DynamicResource SurfaceInset}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel VerticalAlignment="Top">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38"
                                                    Height="38"
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource YellowBg}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RecoveryTabBadgeText}" Value="Ready">
                                                                <Setter Property="Background" Value="{DynamicResource GreenBg}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="&#xEA18;"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="{StaticResource FontSizeTitle}"
                                                           Foreground="{Binding RecoveryTabBadgeColor, Converter={StaticResource StrToBrush}}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="RECOVERY STATUS" Style="{StaticResource SectionEyebrow}"/>
                                                <TextBlock Text="{Binding RecoveryTabBadgeText}"
                                                           Margin="0,4,0,0"
                                                           Foreground="{Binding RecoveryTabBadgeColor, Converter={StaticResource StrToBrush}}"
                                                           FontSize="{StaticResource FontSizeTitle}"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding RecoveryKitStatusText}"
                                                   Margin="0,13,0,0"
                                                   MaxHeight="52"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontSize="{StaticResource FontSizeMeta}"
                                                   LineHeight="17"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
